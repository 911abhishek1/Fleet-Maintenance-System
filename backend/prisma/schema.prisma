generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FLEET_MANAGER
  TECHNICIAN
}

enum ServiceStatus {
  DUE
  BOOKED
  IN_SERVICE
  COMPLETED
}

enum ChecklistItemResult {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  passwordHash            String
  role                    Role
  assignments             TechnicianAssignment[]
  auditLogs               AuditLog[]
  inspectedChecklistItems InspectionChecklistItem[]
}

model Vehicle {
  id                  String          @id @default(uuid())
  registration        String          @unique
  make                String
  model               String
  odometer            Int
  dateIntervalDays    Int
  mileageInterval     Int
  lastServiceDate     DateTime        @default(now())
  lastServiceMileage  Int             @default(0)
  serviceCycle        Int             @default(1)
  dismissedAlertCycle Int             @default(0)
  archived            Boolean         @default(false)
  serviceRecords      ServiceRecord[]
  auditLogs           AuditLog[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model ServiceRecord {
  id                String                    @id @default(uuid())
  vehicleId         String
  vehicle           Vehicle                   @relation(fields: [vehicleId], references: [id])
  cycle             Int                       @default(1)
  description       String
  status            ServiceStatus             @default(DUE)
  dueDate           DateTime?
  dateScheduled     DateTime?
  dateCompleted     DateTime?
  completedOdometer Int?
  assignments       TechnicianAssignment[]
  checklistItems    InspectionChecklistItem[]
  auditLogs         AuditLog[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([vehicleId, status])
  @@index([status, updatedAt])
  @@index([dateScheduled])
}

model InspectionChecklistItem {
  id              String              @id @default(uuid())
  serviceRecordId String
  serviceRecord   ServiceRecord       @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  required        Boolean             @default(false)
  result          ChecklistItemResult @default(PENDING)
  notes           String?
  checkedById     String?
  checkedBy       User?               @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([serviceRecordId])
}

model TechnicianAssignment {
  serviceRecordId String
  userId          String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@id([serviceRecordId, userId])
  @@index([userId])
}

model AuditLog {
  id              String         @id @default(uuid())
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id])
  serviceRecordId String?
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id])
  changedById     String?
  changedBy       User?          @relation(fields: [changedById], references: [id])
  action          String         @default("UPDATE")
  field           String
  oldValue        String?
  newValue        String?
  notes           String?
  createdAt       DateTime       @default(now())
}
